---
import type { WorkMode } from '../lib/jobs-schema';
import { workModeLabel } from '../lib/ui/format';

interface Props {
  mode: WorkMode;
  relocation: boolean;
}
const { mode, relocation } = Astro.props;
---

<span class:list={['mode', { unknown: mode === 'unknown' }]} data-mode={mode}>{workModeLabel(mode, relocation)}</span>

<style>
  /* Work-mode chip: the keyword-chip shape at row scale. No hue: an unstated mode borrows the
     dashed "missing" border, the system's existing sign for absent information. */
  .mode {
    display: inline-block;
    flex: none;
    margin-right: 8px;
    padding: 0 7px;
    border: 1px solid var(--rule-strong);
    border-radius: 5px;
    color: var(--paper);
    font: 500 12px/18px var(--sans);
    vertical-align: 1px;
    white-space: nowrap;
  }
  .unknown {
    border-style: dashed;
    color: var(--muted);
  }
</style>
