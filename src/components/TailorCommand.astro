---
interface Props {
  id: string;
  /** Claude Code command to copy; `/tailor` by default. */
  name?: 'tailor' | 'cover-letter';
  /** The view's one primary action wears yellow; secondary commands get the quiet outline. */
  primary?: boolean;
}
const { id, name = 'tailor', primary = true } = Astro.props;
const command = `/${name} ${id}`;
---

<div class="cmd">
  <code>{command}</code>
  <button type="button" class:list={['btn', { primary }]} data-copy={command} aria-live="polite">Copiar</button>
</div>

<style>
  .cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    padding: 8px 8px 8px 14px;
  }
  code {
    font: 500 14px var(--mono);
    overflow-wrap: anywhere;
    user-select: all;
  }
  button {
    flex: none;
    min-width: 92px;
  }
  button:global(.copied) {
    background: var(--paper);
    border-color: var(--paper);
  }
</style>
