---
interface Props {
  id: string;
}
const { id } = Astro.props;
const command = `/tailor ${id}`;
---

<div class="cmd">
  <code>{command}</code>
  <button type="button" class="btn primary" data-copy={command} aria-live="polite">Copiar</button>
</div>

<style>
  .cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    padding: 8px 8px 8px 14px;
  }
  code {
    font: 500 14px var(--mono);
    overflow-wrap: anywhere;
    user-select: all;
  }
  button {
    flex: none;
    min-width: 92px;
  }
  button:global(.copied) {
    background: var(--paper);
    border-color: var(--paper);
  }
</style>
