---
import type { FramedJob } from '../lib/ui/data';
import { href } from '../lib/ui/data';
import { ageLabel, keywordLabel, strikePath } from '../lib/ui/format';
import Score from './Score.astro';

interface Props {
  job: FramedJob;
  /** Reference date for the static age label (the roll date). */
  today: string;
  selected?: boolean;
}
const { job, today, selected = false } = Astro.props;
const stack = job.matched.slice(0, 3).map(keywordLabel).join(' · ');
const search = [job.title, job.company, job.location, ...job.matched.map(keywordLabel), ...job.matched].join(' ');
---

<li
  class:list={['frame', { sel: selected }]}
  data-job={job.id}
  data-market={job.market}
  data-score={job.score}
  data-first-seen={job.first_seen}
  data-search={search}
  data-status="nueva"
>
  <span class="code mono">{job.frame}</span>
  <div class="who">
    <p class="line">
      <a class="title" href={href(`ofertas/${job.id}/`)} data-select aria-current={selected ? 'true' : undefined}
        >{job.title}</a
      ><span class="tag new" data-new-mark hidden>NUEVA</span><span class="tag applied">POSTULADA</span>
    </p>
    <p class="meta"><span class="pcode" aria-hidden="true">{job.frame}</span>{job.company} · {job.location} · {ageLabel(job.posted_at, today)}</p>
  </div>
  <p class="stack">{stack || 'Sin palabras clave'}</p>
  <div class="bar" aria-hidden="true"><i style={`width:${job.score}%`}></i></div>
  <div class="pts"><Score id={job.id} score={job.score} /></div>
  <svg class="strike" viewBox="0 0 800 40" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d={strikePath(job.id)}></path>
  </svg>
</li>

<style>
  .frame {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 170px 160px 64px;
    align-items: center;
    gap: 16px;
    padding: 14px 12px 14px 4px;
    border-bottom: 1px solid var(--rule);
    transition: background-color 160ms var(--ease);
  }
  .frame:hover {
    background: #17181b;
  }
  .frame.sel {
    background: var(--panel);
  }
  .code {
    font-size: 12px;
    color: var(--muted);
  }
  .who {
    min-width: 0;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }
  .title {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* The whole frame is the link target. */
  .title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title:focus-visible {
    outline: none;
  }
  .title:focus-visible::after {
    outline: 2px solid var(--mark);
    outline-offset: -2px;
  }
  .meta,
  .stack {
    color: var(--muted);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tag {
    flex: none;
    font: 600 11px var(--mono);
    letter-spacing: 0.04em;
    padding: 2px 6px;
    border-radius: 3px;
  }
  .new {
    background: var(--mark);
    color: var(--ink-on-mark);
  }
  .applied {
    display: none;
    border: 1px solid var(--paper);
    color: var(--paper);
  }
  .frame[data-status='postulada'] .applied {
    display: inline;
  }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: var(--rule);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    background: var(--paper);
  }
  .pts {
    text-align: right;
    padding-right: 6px;
  }

  /* Discarded rows stay visible, struck through. */
  .frame[data-status='descartada'] :is(.title, .meta, .stack, .pts, .code, .pcode) {
    color: var(--dim);
  }
  .frame[data-status='descartada'] .bar i {
    background: var(--rule-strong);
  }
  .pcode {
    display: none;
  }
  /*
   * Discard strike: a grease-pencil cross-out like the shortlist ring (same stroke, round caps), varied
   * per id. The 40px box starts at the title line so the stroke crosses the title at its x-height and
   * drifts down toward the score, overshooting the text at both ends.
   */
  .strike {
    position: absolute;
    left: 50px;
    top: var(--strike-top, 8px);
    width: calc(100% - 112px);
    height: 40px;
    overflow: visible;
    fill: none;
    stroke: var(--mark);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .frame[data-status='descartada'] .strike {
    opacity: 1;
  }
  .strike:global(.draw) {
    animation: strike 420ms var(--ease) both;
  }
  @keyframes strike {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 1280px) {
    .frame {
      grid-template-columns: 40px minmax(0, 1fr) 120px 60px;
    }
    .stack {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .frame {
      grid-template-columns: minmax(0, 1fr) 56px;
      grid-template-areas:
        'who pts'
        'bar pts';
      row-gap: 10px;
      column-gap: 12px;
      padding: 14px var(--gutter);
      min-height: 72px;
    }
    .code {
      display: none;
    }
    .pcode {
      display: inline;
      margin-right: 8px;
      font: 500 12px var(--mono);
      color: var(--muted);
    }
    .who {
      grid-area: who;
    }
    .bar {
      grid-area: bar;
      height: 4px;
    }
    .pts {
      grid-area: pts;
    }
    .title {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .line {
      display: block;
    }
    .tag {
      margin-left: 6px;
      vertical-align: 2px;
    }
    .strike {
      left: calc(var(--gutter) - 8px);
      width: calc(100% - var(--gutter) - 56px);
    }
  }
</style>
