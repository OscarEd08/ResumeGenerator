---
/** Shows the real PDF (embedded on desktop) with its PNG page renders as the phone fallback. */
import type { CvEntry } from '../lib/ui/cvs';
import { href } from '../lib/ui/data';

interface Props {
  cv: CvEntry;
}
const { cv } = Astro.props;
const pdf = href(`cv/${cv.pdf}`);
---

<main id="contenido" class="cv">
  <div class="head">
    <div>
      <p class="lbl">{cv.isBase ? 'Perfil completo' : `CV adaptado · ${cv.id}`}</p>
      <h1>{cv.title}</h1>
      {cv.company && <p class="meta">{cv.company} · <a href={href(`ofertas/${cv.id}/`)}>Ver oferta</a></p>}
    </div>
    <div class="actions">
      <a class="btn" href={pdf} target="_blank" rel="noopener">Abrir PDF</a>
      <a class="btn primary" href={pdf} download>Descargar PDF</a>
    </div>
  </div>

  <object class="embed" data={`${pdf}#navpanes=0&view=FitH`} type="application/pdf" aria-label={`PDF: ${cv.title}`}>
    <p class="fallback">Tu navegador no muestra PDF incrustados. <a href={pdf}>Abre el PDF</a> o revisa las páginas abajo.</p>
  </object>

  {
    cv.pages.length > 0 ? (
      <ol class="pages" aria-label="Páginas del CV">
        {cv.pages.map((page, i) => (
          <li>
            <img src={href(`cv/${page}`)} alt={`Página ${i + 1} de ${cv.pages.length} del CV`} width="1240" height="1754" loading={i === 0 ? 'eager' : 'lazy'} />
          </li>
        ))}
      </ol>
    ) : (
      <p class="pages-missing">No hay imágenes de páginas para este CV; usa Abrir PDF.</p>
    )
  }
</main>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px var(--gutter) 48px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  h1 {
    margin-top: 6px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .meta {
    margin-top: 4px;
    color: var(--muted);
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  .embed {
    width: 100%;
    height: calc(100vh - 190px);
    min-height: 560px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--panel);
  }
  .fallback {
    padding: 24px;
    color: var(--muted);
  }
  .pages,
  .pages-missing {
    display: none;
  }
  .pages {
    flex-direction: column;
    gap: 12px;
  }
  .pages img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    background: #fff;
  }

  @media (max-width: 760px) {
    .embed {
      display: none;
    }
    .pages {
      display: flex;
    }
    .pages-missing {
      display: block;
      color: var(--muted);
    }
    .actions {
      width: 100%;
    }
    .actions .btn {
      flex: 1;
    }
  }
</style>
