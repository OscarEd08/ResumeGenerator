---
/** CV preview: the PNG page renders, each page whole on the ground, plus download and the native PDF viewer. */
import type { CvEntry } from '../lib/ui/cvs';
import { href } from '../lib/ui/data';

interface Props {
  cv: CvEntry;
}
const { cv } = Astro.props;
const pdf = href(`cv/${cv.pdf}`);
const total = cv.pages.length;
---

<main id="contenido" class="cv">
  <div class="head">
    <div class="who">
      <h1>{cv.title}</h1>
      <p class="meta">
        {
          cv.isBase ? (
            <span>Perfil completo, sin adaptar</span>
          ) : (
            <>
              <span class="code">{cv.id}</span>
              {cv.company && <span>{cv.company}</span>}
              <a href={href(`ofertas/${cv.id}/`)}>Ver oferta</a>
            </>
          )
        }
        {total > 0 && <span class="code">{total} {total === 1 ? 'página' : 'páginas'}</span>}
      </p>
    </div>
    <div class="actions">
      <a class="btn" href={pdf} target="_blank" rel="noopener">Abrir PDF</a>
      {cv.letter && <a class="btn" href={href(`cv/${cv.letter.pdf}`)} download={cv.letter.downloadName}>Descargar carta</a>}
      <a class="btn primary" href={pdf} download={cv.downloadName}>Descargar PDF</a>
    </div>
  </div>

  {
    total > 0 ? (
      <ol class="pages" aria-label="Páginas del CV">
        {cv.pages.map((page, i) => (
          <li>
            <img
              src={href(`cv/${page}`)}
              alt={`Página ${i + 1} de ${total} del CV`}
              width="1240"
              height="1754"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {total > 1 && (
              <p class="folio" aria-hidden="true">
                {i + 1} / {total}
              </p>
            )}
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty">
        <p class="empty-title">Este CV no tiene imágenes de sus páginas.</p>
        <p>Ábrelo en el visor del navegador con Abrir PDF o descárgalo.</p>
      </div>
    )
  }
</main>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px var(--gutter) 56px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  h1 {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    color: var(--muted);
  }
  .meta a {
    color: var(--soft);
  }
  .code {
    font: 500 12px var(--mono);
  }
  .actions {
    display: flex;
    gap: 8px;
  }
  /* Paper on the ground: each page whole inside the viewport, no frame, no shadow. */
  .pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .pages li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
  }
  .pages img {
    display: block;
    width: min(100%, calc((100svh - 96px) * 1240 / 1754));
    height: auto;
    border-radius: 2px;
    background: #fff;
  }
  .folio {
    font: 500 12px var(--mono);
    color: var(--muted);
  }
  .empty {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 60ch;
    padding: 32px 0;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }
  .empty-title {
    color: var(--paper);
    font-size: 17px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .cv {
      gap: 20px;
    }
    .pages {
      gap: 20px;
    }
    .pages img {
      width: 100%;
    }
    .actions {
      width: 100%;
    }
    .actions .btn {
      flex: 1;
    }
  }
</style>
