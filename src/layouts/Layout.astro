---
import '../styles/global.css';
import { href, latestRoll, loadJobs } from '../lib/ui/data';

interface Props {
  title: string;
  current?: 'ofertas' | 'cvs' | 'cv-base' | null;
}

const { title, current = null } = Astro.props;
const { file, jobs } = loadJobs();
const roll = latestRoll(file);
const fresh = jobs.filter((j) => j.first_seen === roll).length;
/* Minimal roll index for the client-side NUEVOS count: [id, first_seen] per job, same on every page. */
const rollIndex = JSON.stringify(jobs.map((j) => [j.id, String(j.first_seen)]));

const nav = [
  { key: 'ofertas', label: 'Ofertas', to: href() },
  { key: 'preseleccionadas', label: 'Preseleccionadas', to: href('?estado=preseleccionada') },
  { key: 'cvs', label: 'CVs', to: href('cvs/') },
  { key: 'cv-base', label: 'CV base', to: href('cv-base/') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111214" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preload" href={href('fonts/familjen-grotesk-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href('fonts/azeret-mono-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <title>{title} · OP / Empleos</title>
  </head>
  <body data-roll={roll}>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="top">
      <a class="brand" href={href()} aria-label="OP / Empleos, inicio">OP<span class="brand-rest"> / EMPLEOS</span></a>
      <nav aria-label="Secciones">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.to}
                  data-nav={item.key}
                  aria-current={item.key === current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="roll mono">
        ROLLO {roll} · {jobs.length} CUADROS · <span data-new-count>{fresh}</span> NUEVOS
      </p>
    </header>
    <slot />
    <script is:inline type="application/json" id="roll-jobs" set:html={rollIndex} />
    <script>
      import '../scripts/cockpit';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -60px;
    z-index: 10;
    padding: 8px 12px;
    background: var(--mark);
    color: var(--ink-on-mark);
    font-weight: 600;
  }
  .skip:focus {
    top: 8px;
  }
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 var(--gutter);
    min-height: 60px;
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
  }
  .brand {
    font: 600 15px var(--mono);
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
  }
  nav ul {
    display: flex;
    gap: 22px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 60px;
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color 160ms var(--ease);
  }
  nav a:hover {
    color: var(--paper);
  }
  nav a[aria-current] {
    color: var(--paper);
    border-bottom-color: var(--paper);
  }
  .roll {
    margin-left: auto;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .roll {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .top {
      gap: 16px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      gap: 18px;
    }
    .brand-rest {
      display: none;
    }
    nav a {
      min-height: 52px;
      white-space: nowrap;
    }
  }
</style>
